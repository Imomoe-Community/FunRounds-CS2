{
  "$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/tags/v3.1.0/schemas/plugin.schema.json",
  "version": "0.3.0-alpha.test.2",
  "name": "funrounds_native",
  "description": "Native Source 2 damage, pickup, touch, collision, chicken-use, suicide-input, ground-reverse, bot-visibility, ghost-radar and passive sound-message hooks for FunRounds",
  "author": "Mai Ooizumi",
  "website": "https://github.com/Mai-Ooizumi",
  "license": "AGPL-3.0-or-later",
  "entry": "bin/funrounds-native",
  "platforms": [],
  "language": "cpp",
  "dependencies": [
    {
      "name": "s2sdk",
      "constraints": "=3.0.6"
    },
    {
      "name": "polyhook",
      "constraints": ">=2.5.7"
    }
  ],
  "methods": [
    {
      "name": "HasPlayerRandomSpawnPointSupport",
      "funcName": "HasPlayerRandomSpawnPointSupport",
      "group": "RandomSpawn",
      "description": "Whether the native engine spawn-point selector is available. Call on the game thread.",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "SelectPlayerRandomSpawnPoint",
      "funcName": "SelectPlayerRandomSpawnPoint",
      "group": "RandomSpawn",
      "description": "Validate and select a map-defined deathmatch spawn point for an exact pawn, starting at a complete point handle. Returns a complete handle, or -1 including engine fallback to normal team starts. Does not move the player. Game thread only.",
      "paramTypes": [
        {
          "name": "pawnHandle",
          "type": "int32"
        },
        {
          "name": "startPointHandle",
          "type": "int32"
        }
      ],
      "retType": {
        "type": "int32"
      }
    },
    {
      "name": "HasThirdPersonEyeSupport",
      "funcName": "HasThirdPersonEyeSupport",
      "group": "ThirdPerson",
      "description": "On the game thread, checks the optional pawn eye camera-branch Hook ABI and schema. Does not change any view.",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "RegisterThirdPersonEyeTarget",
      "funcName": "RegisterThirdPersonEyeTarget",
      "group": "ThirdPerson",
      "description": "On the game thread, registers one exact pawn/camera pair before assigning its view. Only a live own-camera path uses the original pawn eye branch.",
      "paramTypes": [
        {
          "name": "pawn",
          "type": "int32",
          "ref": false
        },
        {
          "name": "camera",
          "type": "int32",
          "ref": false
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "UnregisterThirdPersonEyeTarget",
      "funcName": "UnregisterThirdPersonEyeTarget",
      "group": "ThirdPerson",
      "description": "On the game thread, removes an exact pair only after its pawn view no longer references the owned camera. A failed detach remains retryable.",
      "paramTypes": [
        {
          "name": "pawn",
          "type": "int32",
          "ref": false
        },
        {
          "name": "camera",
          "type": "int32",
          "ref": false
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "ResetThirdPersonEyeTargets",
      "funcName": "ResetThirdPersonEyeTargets",
      "group": "ThirdPerson",
      "description": "Map transition only: drops all old-map target identities and detaches the eye Hook without resolving or modifying reused entity handles.",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "TryIgnitePlayer",
      "funcName": "TryIgnitePlayer",
      "group": "Afterburn",
      "description": "On the game thread, attempts native mode-14 ignition for one exact current live player pawn without replacing a valid attached effect. Returns the new attached entityflame full handle for exact caller-owned lifecycle cleanup, or -1 when validation or readback fails.",
      "paramTypes": [
        {
          "name": "pawnHandle",
          "type": "int32",
          "ref": false
        },
        {
          "name": "duration",
          "type": "float",
          "ref": false
        }
      ],
      "retType": {
        "type": "int32",
        "description": "-1 on validation/effect verification failure; otherwise the newly attached entityflame full handle."
      }
    },
    {
      "name": "HasSuicideSupport",
      "funcName": "HasSuicideSupport",
      "group": "Suicide",
      "description": "Reports whether the optional CanAcquire hook and inspect-button schema are available.",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "GetLookAtWeaponButtonState",
      "funcName": "GetLookAtWeaponButtonState",
      "group": "Suicide",
      "description": "Returns live IN_LOOK_AT_WEAPON state for an exact pawn handle, or -1 when unavailable.",
      "paramTypes": [
        {
          "name": "pawnHandle",
          "type": "int32",
          "ref": false
        }
      ],
      "retType": {
        "type": "int32"
      }
    },
    {
      "name": "HookPlayerCanAcquire",
      "funcName": "HookPlayerCanAcquire",
      "group": "Suicide",
      "description": "Hooks pickup acquisition decisions so only active suicide bombers are denied weapon pickups.",
      "paramTypes": [
        {
          "name": "callback",
          "type": "function",
          "prototype": "PlayerCanAcquireCallback",
          "ref": false
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "UnhookPlayerCanAcquire",
      "funcName": "UnhookPlayerCanAcquire",
      "group": "Suicide",
      "description": "Removes the optional CanAcquire detour and callback.",
      "paramTypes": [
        {
          "name": "callback",
          "type": "function",
          "prototype": "PlayerCanAcquireCallback",
          "ref": false
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "HasPlayerTakeDamagePre",
      "funcName": "HasPlayerTakeDamagePre",
      "group": "Damage",
      "description": "Reports whether the current native damage-hook prerequisites are available.",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "HookPlayerTakeDamagePre",
      "funcName": "HookPlayerTakeDamagePre",
      "group": "Damage",
      "description": "Installs the exclusive synchronous player damage policy callback.",
      "paramTypes": [
        {
          "name": "callback",
          "type": "function",
          "prototype": "DamagePreCallback",
          "ref": false
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "UnhookPlayerTakeDamagePre",
      "funcName": "UnhookPlayerTakeDamagePre",
      "group": "Damage",
      "description": "Revokes the player damage callback and removes its detour.",
      "paramTypes": [
        {
          "name": "callback",
          "type": "function",
          "prototype": "DamagePreCallback",
          "ref": false
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "HasEntityTakeDamagePre",
      "funcName": "HasEntityTakeDamagePre",
      "group": "Damage",
      "description": "Reports whether the shared non-player damage callback prerequisites are available without player-only headshot tracing.",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "HookEntityTakeDamagePre",
      "funcName": "HookEntityTakeDamagePre",
      "group": "Damage",
      "description": "Subscribes one synchronous non-player entity damage callback to the shared TakeDamageOld detour; nonzero suppresses native damage.",
      "paramTypes": [
        {
          "name": "callback",
          "type": "function",
          "prototype": "EntityDamagePreCallback",
          "ref": false
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "UnhookEntityTakeDamagePre",
      "funcName": "UnhookEntityTakeDamagePre",
      "group": "Damage",
      "description": "Revokes this entity damage callback and removes the shared detour only when no damage callbacks remain. Returns true when this callback is absent or revoked; other callbacks are untouched.",
      "paramTypes": [
        {
          "name": "callback",
          "type": "function",
          "prototype": "EntityDamagePreCallback",
          "ref": false
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "GetCurrentDamageFrameToken",
      "funcName": "GetCurrentDamageFrameToken",
      "group": "Damage",
      "description": "Returns the current nested damage-call token, or zero outside a damage call.",
      "paramTypes": [],
      "retType": {
        "type": "uint64"
      }
    },
    {
      "name": "TakeEntityDamageWithWeapon",
      "funcName": "TakeEntityDamageWithWeapon",
      "group": "Damage",
      "description": "Applies native damage with an exact ability weapon handle and optional callback-specific rule bypass; returns -1 on execution failure, otherwise the actual non-negative health lost (0 is valid).",
      "paramTypes": [
        {
          "name": "victimHandle",
          "type": "int32",
          "ref": false
        },
        {
          "name": "inflictorHandle",
          "type": "int32",
          "ref": false
        },
        {
          "name": "attackerHandle",
          "type": "int32",
          "ref": false
        },
        {
          "name": "force",
          "type": "vec3",
          "ref": false
        },
        {
          "name": "position",
          "type": "vec3",
          "ref": false
        },
        {
          "name": "amount",
          "type": "float",
          "ref": false
        },
        {
          "name": "damageType",
          "type": "int32",
          "ref": false
        },
        {
          "name": "weaponHandle",
          "type": "int32",
          "ref": false
        },
        {
          "name": "skipPluginRules",
          "type": "bool",
          "ref": false
        }
      ],
      "retType": {
        "type": "int32",
        "description": "-1 on execution failure; otherwise actual non-negative health lost, including 0."
      }
    },
    {
      "name": "IsEntityTouchPreHookAvailable",
      "funcName": "IsEntityTouchPreHookAvailable",
      "group": "Entities",
      "description": "Reports whether the Touch vtable offset is available in the native gamedata.",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "HookEntityTouchPre",
      "funcName": "HookEntityTouchPre",
      "group": "Entities",
      "description": "Hooks the entity's current Touch implementation address; the callback sees all entities sharing it.",
      "paramTypes": [
        {
          "name": "entityHandle",
          "type": "int32",
          "ref": false
        },
        {
          "name": "callback",
          "type": "function",
          "prototype": "EntityTouchPreCallback",
          "ref": false
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "UnhookEntityTouchPre",
      "funcName": "UnhookEntityTouchPre",
      "group": "Entities",
      "description": "Returns true for a non-null callback with no hooks or after all its hooks detach; false for null or incomplete own-hook detachment. Other callbacks' hooks are untouched.",
      "paramTypes": [
        {
          "name": "callback",
          "type": "function",
          "prototype": "EntityTouchPreCallback",
          "ref": false
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "SetEntityDefaultCollisionGroup",
      "funcName": "SetEntityDefaultCollisionGroup",
      "group": "Entities",
      "description": "Sets both collision-group fields to the standard default and notifies collision rules.",
      "paramTypes": [
        {
          "name": "entityHandle",
          "type": "int32",
          "ref": false
        }
      ],
      "retType": {
        "type": "void"
      }
    },
    {
      "name": "HasGroundReverseSupport",
      "funcName": "HasGroundReverseSupport",
      "group": "GroundReverse",
      "description": "Reports whether the platform ground-reverse callsite and current-controller identity schema are available.",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "SetGroundReverseActive",
      "funcName": "SetGroundReverseActive",
      "group": "GroundReverse",
      "description": "Enables ground-reversed human movement and normal BOT movement with the configured local ground acceleration; false detaches the hook.",
      "paramTypes": [
        {
          "name": "active",
          "type": "bool",
          "ref": false
        },
        {
          "name": "acceleration",
          "type": "float",
          "ref": false
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "HasGhostVisibilitySupport",
      "funcName": "HasGhostVisibilitySupport",
      "group": "GhostVisibility",
      "description": "Installs the resident CCSBot visibility hook and reports whether its current-platform signature is available.",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "SetGhostVisibilityTargets",
      "funcName": "SetGhostVisibilityTargets",
      "group": "GhostVisibility",
      "description": "Atomically replaces the exact full pawn-handle set hidden from BOT visibility; an empty set clears the filter.",
      "paramTypes": [
        {
          "name": "pawnHandles",
          "type": "int32[]",
          "ref": false
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "HasGhostRadarSupport",
      "funcName": "HasGhostRadarSupport",
      "group": "GhostRadar",
      "description": "On the game thread, reports whether both the per-recipient radar update filter and spotted-state filter are ready.",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "HasGhostPassiveSoundMessageSupport",
      "funcName": "HasGhostPassiveSoundMessageSupport",
      "group": "GhostVisibility",
      "description": "On the game thread, reports whether the per-recipient filter for the complete paired passive movement sound-event family is ready for fully hidden Ghost pawn handles. It filters client sound messages only; Hostage.Breath and active combat sounds remain visible.",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "HasGhostPassiveNoiseSupport",
      "funcName": "HasGhostPassiveNoiseSupport",
      "group": "GhostVisibility",
      "description": "On the game thread, reports whether the scoped CCSBotManager::OnPlayerFootstep/per-BOT noise filter is ready. It suppresses only footsteps from exact fully hidden Ghost pawns to the exact connected enemy BOT controller; other noise, fall damage, teammates, and combat stay native.",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "SetGhostRadarTargets",
      "funcName": "SetGhostRadarTargets",
      "group": "GhostRadar",
      "description": "On the game thread, publishes full pawn handles and parallel 64-bit masks of living enemy recipients whose radar updates must be hidden. Empty parallel arrays clear the snapshot.",
      "paramTypes": [
        {
          "name": "fullPawnHandles",
          "type": "int32[]",
          "ref": false
        },
        {
          "name": "enemyRecipientMasks",
          "type": "uint64[]",
          "ref": false
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "HasUseTargetSupport",
      "funcName": "HasUseTargetSupport",
      "group": "ChickenEating",
      "description": "Reports whether the exact committed player-use target callback is available on this platform.",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "HookUseTarget",
      "funcName": "HookUseTarget",
      "group": "ChickenEating",
      "description": "Observes the exact outer use-selector result and committed target for a live player pawn.",
      "paramTypes": [
        {
          "name": "callback",
          "type": "function",
          "prototype": "UseTargetCallback",
          "ref": false
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "UnhookUseTarget",
      "funcName": "UnhookUseTarget",
      "group": "ChickenEating",
      "description": "Removes only this callback from the committed use-target observation hook.",
      "paramTypes": [
        {
          "name": "callback",
          "type": "function",
          "prototype": "UseTargetCallback",
          "ref": false
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "HasChickenFollowBlockSupport",
      "funcName": "HasChickenFollowBlockSupport",
      "group": "ChickenFollow",
      "description": "Reports whether the exact CChickenChickenUse callback detour is available on this platform.",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "SetChickenFollowBlocking",
      "funcName": "SetChickenFollowBlocking",
      "group": "ChickenFollow",
      "description": "On the game thread, enables the native chicken-follow veto or disables it and removes only this provider's detour. Returns false while setup or owned-hook cleanup remains incomplete.",
      "paramTypes": [
        {
          "name": "active",
          "type": "bool",
          "ref": false
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "HasHealthshotSupport",
      "funcName": "HasHealthshotSupport",
      "group": "Healthshot",
      "description": "Reports whether the healthshot eligibility and successful-effect hooks resolve on this platform.",
      "paramTypes": [],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "HookHealthshot",
      "funcName": "HookHealthshot",
      "group": "Healthshot",
      "description": "Blocks only the custom B-relative cap decision before consumption and reports successful native effects afterward.",
      "paramTypes": [
        {
          "name": "canUse",
          "type": "function",
          "prototype": "HealthshotCanUseCallback",
          "ref": false
        },
        {
          "name": "effect",
          "type": "function",
          "prototype": "HealthshotEffectCallback",
          "ref": false
        }
      ],
      "retType": {
        "type": "bool"
      }
    },
    {
      "name": "UnhookHealthshot",
      "funcName": "UnhookHealthshot",
      "group": "Healthshot",
      "description": "Removes only the two healthshot callbacks owned by this provider consumer.",
      "paramTypes": [
        {
          "name": "canUse",
          "type": "function",
          "prototype": "HealthshotCanUseCallback",
          "ref": false
        },
        {
          "name": "effect",
          "type": "function",
          "prototype": "HealthshotEffectCallback",
          "ref": false
        }
      ],
      "retType": {
        "type": "bool"
      }
    }
  ],
  "prototypes": [
    {
      "name": "PlayerCanAcquireCallback",
      "funcName": "PlayerCanAcquireCallback",
      "description": "Synchronous pickup decision for exact player pawn and controller handles.",
      "paramTypes": [
        {
          "name": "pawnHandle",
          "type": "int32"
        },
        {
          "name": "controllerHandle",
          "type": "int32"
        }
      ],
      "retType": {
        "type": "int32"
      }
    },
    {
      "name": "DamagePreCallback",
      "funcName": "DamagePreCallback",
      "description": "Synchronous player damage decision with native damage type, exact weapon handle, and per-call rule scope.",
      "paramTypes": [
        {
          "name": "victimHandle",
          "type": "int32"
        },
        {
          "name": "attackerHandle",
          "type": "int32"
        },
        {
          "name": "inflictorHandle",
          "type": "int32"
        },
        {
          "name": "weaponKind",
          "type": "int32"
        },
        {
          "name": "hitGroup",
          "type": "int32"
        },
        {
          "name": "tracedHead",
          "type": "bool"
        },
        {
          "name": "damage",
          "type": "float"
        },
        {
          "name": "damageType",
          "type": "uint32"
        },
        {
          "name": "multiplier",
          "type": "float",
          "ref": true
        },
        {
          "name": "markHeadshot",
          "type": "bool",
          "ref": true
        },
        {
          "name": "weaponHandle",
          "type": "int32"
        },
        {
          "name": "skipPluginRules",
          "type": "bool"
        }
      ],
      "retType": {
        "type": "int32"
      }
    },
    {
      "name": "EntityDamagePreCallback",
      "funcName": "EntityDamagePreCallback",
      "description": "Synchronous raw non-player entity damage decision with exact victim/source handles, damage type, and per-call rule scope; return zero to allow or nonzero to suppress.",
      "paramTypes": [
        {
          "name": "victimHandle",
          "type": "int32"
        },
        {
          "name": "attackerHandle",
          "type": "int32"
        },
        {
          "name": "inflictorHandle",
          "type": "int32"
        },
        {
          "name": "abilityHandle",
          "type": "int32"
        },
        {
          "name": "damage",
          "type": "float"
        },
        {
          "name": "damageType",
          "type": "uint32"
        },
        {
          "name": "skipPluginRules",
          "type": "bool"
        }
      ],
      "retType": {
        "type": "int32"
      }
    },
    {
      "name": "EntityTouchPreCallback",
      "funcName": "EntityTouchPreCallback",
      "description": "Synchronous decision for every entity sharing the selected Touch implementation.",
      "paramTypes": [
        {
          "name": "entityHandle",
          "type": "int32"
        },
        {
          "name": "otherHandle",
          "type": "int32"
        }
      ],
      "retType": {
        "type": "int32"
      }
    },
    {
      "name": "UseTargetCallback",
      "funcName": "UseTargetCallback",
      "description": "Synchronous target observation for an exact live player pawn; target is -1 if no committed match and inUse reports the current E state.",
      "paramTypes": [
        {
          "name": "pawnHandle",
          "type": "int32"
        },
        {
          "name": "targetHandle",
          "type": "int32"
        },
        {
          "name": "inUse",
          "type": "bool"
        }
      ],
      "retType": {
        "type": "void"
      }
    },
    {
      "name": "HealthshotCanUseCallback",
      "funcName": "HealthshotCanUseCallback",
      "description": "Returns nonzero only to veto custom healthshot use for the exact player life and healthshot inventory entity.",
      "paramTypes": [
        {
          "name": "pawnHandle",
          "type": "int32"
        },
        {
          "name": "weaponHandle",
          "type": "int32"
        }
      ],
      "retType": {
        "type": "int32"
      }
    },
    {
      "name": "HealthshotEffectCallback",
      "funcName": "HealthshotEffectCallback",
      "description": "Reports the completed native healthshot effect for exact pawn and inventory-weapon handles.",
      "paramTypes": [
        {
          "name": "pawnHandle",
          "type": "int32"
        },
        {
          "name": "weaponHandle",
          "type": "int32"
        }
      ],
      "retType": {
        "type": "void"
      }
    }
  ]
}

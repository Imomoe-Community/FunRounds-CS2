    {
      "name": "HookEntityTouchPre",
      "group": "Entities",
      "description": "Detours the Touch function address used by this entity. The callback is shared by every entity using that same function address, not limited to entityHandle.",
      "funcName": "HookEntityTouchPre",
      "paramTypes": [
        {
          "name": "entityHandle",
          "type": "int32",
          "ref": false,
          "description": "The full handle used to select the current Touch function address."
        },
        {
          "name": "callback",
          "type": "function",
          "ref": false,
          "description": "Called for every entity using the selected function address, with the actual entity and other full handles; nonzero supersedes native Touch. Filter entityHandle in the callback.",
          "prototype": "EntityTouchPreCallback"
        }
      ],
      "retType": {
        "type": "bool",
        "description": "True when the selected function address is hooked for this callback."
      }
    },
    {
      "name": "UnhookEntityTouchPre",
      "group": "Entities",
      "description": "Removes every Touch function-address detour registered by the callback and revokes it.",
      "funcName": "UnhookEntityTouchPre",
      "paramTypes": [
        {
          "name": "callback",
          "type": "function",
          "ref": false,
          "description": "The callback previously registered by HookEntityTouchPre.",
          "prototype": "EntityTouchPreCallback"
        }
      ],
      "retType": {
        "type": "bool",
        "description": "True when the callback is revoked and native hooks are removed."
      }
    },
